# Instagram Graph API (Facebook Login 系統) 用の資格情報
# 値は絶対にコミットしないこと。実ファイルは .env として作成する。

# Meta App (Business 種別) の設定値
META_APP_ID=
META_APP_SECRET=

# あなたの Instagram Business/Creator アカウント (自分側)
# Graph API Explorer などで長期トークン化 (60日) 済みのものを使用
IG_USER_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# 取得対象 (RAPSTAR公式)
TARGET_IG_USERNAME=rapstar_starz

# Graph API バージョン (2026-07-29 リリースの v26.0 を使用。動作確認済みバージョンを固定する)
GRAPH_API_VERSION=v26.0

# データ保存先。ローカル開発は SQLite。PostgreSQL 移行時は URL のみ差替。
# 例: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/rapstar
DATABASE_URL=sqlite:///data/rapstar.db
