# Copy to `.env.local` (gitignored) and fill in the actual API base URL.
# The base URL points to the deployed Read API HTTP API stage root
# (without a trailing slash). Paths like `/api/status` are appended by
# the API client.
#
# Example values:
#   VITE_API_BASE_URL=https://<api-id>.execute-api.ap-northeast-1.amazonaws.com
#
# When VITE_API_BASE_URL is unset OR VITE_USE_MOCK=true, the frontend runs
# against `mockClient` and displays a "MOCK DATA" banner.
VITE_API_BASE_URL=
VITE_USE_MOCK=
